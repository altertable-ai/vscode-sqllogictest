{
  "name": "sqllogictest",
  "displayName": "Sqllogictest",
  "description": "Sqllogictest support for Visual Studio Code",
  "version": "0.2.1",
  "license": "MIT",
  "publisher": "altertable-ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/altertable-ai/vscode-sqllogictest"
  },
  "homepage": "https://github.com/altertable-ai/vscode-sqllogictest#readme",
  "bugs": {
    "url": "https://github.com/altertable-ai/vscode-sqllogictest/issues"
  },
  "icon": "images/logo.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "sqllogictest",
        "aliases": [
          "Sqllogictest",
          "sqllogictest"
        ],
        "extensions": [
          ".slt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sqllogictest",
        "scopeName": "source.sqllogictest",
        "path": "./syntaxes/sqllogictest.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile && npm run lint",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.3.3"
  }
}
